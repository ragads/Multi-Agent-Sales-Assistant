# ---------- LLM + Embeddings (one OpenAI key covers both) ----------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Supabase ----------
# NOTE: there is no SUPABASE_SERVICE_KEY. The service-role key bypasses row-level
# security on every table, and nothing in this app needs it - all database access is a
# direct Postgres connection as the least-privilege `closefuture_app` role, governed by
# the policies in sql/004_rls_policies.sql. See README section 2.1.1.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Runtime connection, as the least-privilege role created by sql/003_app_role.sql.
# Port 5432 (session mode) is required: the booking flow holds a pg_advisory_lock across
# statements and needs a pinned connection.
SUPABASE_DB_URL=postgresql://closefuture_app.xxxx:APP_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Owner connection (Settings -> Database -> Connection string -> URI).
# Used ONLY by `python -m app.rag.ingest` and to run the files in sql/. Never serves a
# request. Leave it unset in production if you do not re-ingest there.
SUPABASE_ADMIN_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------- Google Calendar ----------
GOOGLE_CALENDAR_ID=baskaran@closefuture.io
# base64 of the downloaded service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCi4uLgp9
# Personal Gmail calendar? Use OAuth (Meet links + invites need it): python scripts/google_oauth_setup.py
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Workspace alternative: domain-wide delegation
GOOGLE_IMPERSONATE_USER=
CALENDAR_OWNER_TZ=Asia/Kolkata
BUSINESS_HOURS=10:00-18:00
SLOT_MINUTES=30

# ---------- Email ----------
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=CloseFuture Bot <bot@closefuture.io>
SALES_INBOX=baskaran@closefuture.io

# ---------- App ----------
APP_BASE_URL=http://localhost:8000
SESSION_IDLE_TIMEOUT_MIN=15
SESSION_EXPIRY_DAYS=30
MCP_CALENDAR_URL=http://localhost:8931/mcp
MCP_EMAIL_URL=http://localhost:8932/mcp
LOG_LEVEL=INFO

# ---------- Access control ----------
# generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=
ADMIN_TOKEN=
# extra website origins allowed to call the API, comma separated (e.g. https://www.closefuture.io)
ALLOWED_ORIGINS=
