# ---------- LLM + Embeddings (one OpenAI key covers both) ----------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Supabase ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...
# Settings -> Database -> Connection string -> URI (session pooler works fine)
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------- Google Calendar ----------
GOOGLE_CALENDAR_ID=baskaran@closefuture.io
# base64 of the downloaded service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCi4uLgp9
CALENDAR_OWNER_TZ=Asia/Kolkata
BUSINESS_HOURS=10:00-18:00
SLOT_MINUTES=30

# ---------- Email ----------
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=CloseFuture Bot <bot@closefuture.io>
SALES_INBOX=baskaran@closefuture.io

# ---------- App ----------
APP_BASE_URL=http://localhost:8000
SESSION_IDLE_TIMEOUT_MIN=15
SESSION_EXPIRY_DAYS=30
MCP_CALENDAR_URL=http://localhost:8931/mcp
MCP_EMAIL_URL=http://localhost:8932/mcp
LOG_LEVEL=INFO

# ---------- MCP server auth (one token per server; 32+ chars) ----------
# generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_CALENDAR_TOKEN=
MCP_EMAIL_TOKEN=
# 127.0.0.1 keeps the MCP servers off the network; docker-compose sets 0.0.0.0 on its internal network
MCP_BIND_HOST=127.0.0.1

# ---------- Session lease lock ----------
SESSION_LOCK_TTL_S=60
SESSION_LOCK_WAIT_S=45

# ---------- Observability (optional) ----------
# Langfuse project keys from cloud.langfuse.com -> Settings -> API Keys. Leave blank to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# USD per 1M tokens, for the cost column of our own llm_call log rows
OPENAI_PRICE_IN_PER_M=0.15
OPENAI_PRICE_OUT_PER_M=0.60

# ---------- Alternative LLM provider (any OpenAI-compatible API) ----------
# Blank = OpenAI. For Google Gemini (free tier via Google AI Studio):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=<AI Studio key>
#   OPENAI_CHAT_MODEL=gemini-3.5-flash-lite
#   EMBEDDING_MODEL=gemini-embedding-2
#   MIN_SIMILARITY=0.60   CONFIDENCE_FLOOR=0.60   (Gemini similarities run higher)
# After switching embedding models, re-run: python -m app.rag.ingest
LLM_BASE_URL=
LLM_API_KEY=
